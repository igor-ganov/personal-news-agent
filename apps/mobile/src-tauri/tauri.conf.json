{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Личный агент",
  "version": "0.1.0",
  "identifier": "dev.ganov.pna",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "pnpm --filter @pna/mobile dev",
    "beforeBuildCommand": "pnpm --filter @pna/mobile build"
  },
  "app": {
    "windows": [
      {
        "title": "Личный агент",
        "width": 420,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.anthropic.com https://pna-api.igor-ganov.workers.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
